<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine, shared by the front ends in apps/:
      apps/Cli      - command line (the original program, FileOrganizer.exe <folder>)
      apps/Desktop  - Avalonia desktop app for Windows and Linux
      apps/Web      - browser interface, also for headless Linux servers and NAS
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Plain net10.0 (no "-windows" suffix) so the app builds and runs on Linux, macOS and Windows -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FileOrganizer.Core</AssemblyName>
    <RootNamespace>FileOrganizer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The front ends and tests live in sub folders with their own projects -->
    <Compile Remove="apps/**;tests/**" />
    <None Remove="apps/**;tests/**" />
    <Content Remove="apps/**;tests/**" />
    <EmbeddedResource Remove="apps/**;tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Video frame extraction -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />

    <!-- OCR: PP-OCRv5 (PaddleOCR) models running on ONNX Runtime, replaces Windows.Media.Ocr -->
    <PackageReference Include="RapidOCRSharpOnnx" Version="1.3.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />

    <!-- RapidOCRSharpOnnx uses SkiaSharp internally; Linux needs the native library explicitly -->
    <PackageReference Include="SkiaSharp" Version="4.151.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.2" />

    <!-- Metadata (title/comment) -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>

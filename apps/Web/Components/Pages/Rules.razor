@page "/rules"
@implements IDisposable
@inject AppController App
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Rules</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1>Rules</h1>
            <p>Each category is a folder. The list is alphabetical. A file goes to the category with the highest priority (the lowest number) that matches its name, its title or comment tag, or the text in the video. Use the arrows to give the more specific categories a higher priority.</p>
        </div>
        <div class="inline">
            <button disabled="@(!edited)" @onclick="Revert">Undo changes</button>
            <button class="primary big" disabled="@(!edited)" @onclick="Save">Save</button>
        </div>
    </div>

    @if (App.SettingsError != null && !savedOnce)
    {
        <div class="notice warn"><p><strong>settings.json could not be read:</strong> @App.SettingsError</p><p>Saving here replaces it (the old file is kept as settings.json.bck).</p></div>
    }
    @if (problems.Count > 0)
    {
        <div class="notice warn" role="alert"><p><strong>Not saved:</strong></p><ul>@foreach (var p in problems) { <li>@p</li> }</ul></div>
    }

    <div class="cat-layout @(GuideOpen ? "has-guide" : "")">
        <div>
            @* Filter category: the name first, then the strings of the rules (a file name or a line of text finds the categories whose rules match it) *@
            @{ var hits = CategoryFilter.Apply(cats, filterText); }
            <input type="search" class="cat-filter" placeholder="Filter category: part of a name, or of a rule's text" @bind="filterText" @bind:event="oninput" aria-label="Filter category" />
            @if (filterText.Trim().Length > 0)
            {
                <p class="muted" aria-live="polite" style="margin:4px 0 8px">@(hits.Count == 0 ? "No category has this in its name or in a rule, and no rule matches it." : $"{hits.Count:N0} of {cats.Count:N0} categories: {hits.Count(h => h.Reason == null):N0} by name" + (hits.Any(h => h.Reason != null) ? $", {hits.Count(h => h.Reason != null):N0} by a rule" : "") + ".")</p>
            }
            @* A letter or number typed with the list in use selects the first category that starts with it *@
            <div class="cat-list" tabindex="0" @onkeydown="ListKey" aria-label="Categories">
                @foreach (var h in hits)
                {
                    var c = h.Category;
                    <button class="cat-item @(c == selected ? "selected" : "")" @onclick="() => selected = c">
                        <span>@(c.Name.Length == 0 ? "(no name)" : c.Name)</span>
                        <span class="muted">Priority @(cats.IndexOf(c) + 1)@(FilesOf(c).Length > 0 ? " · " + FilesOf(c) : "")</span>
                        @if (h.Reason != null) { <span class="cat-reason">@h.Reason</span> }
                    </button>
                }
                @if (cats.Count == 0) { <p class="muted" style="padding:12px">No categories yet.</p> }
            </div>
            <p class="inline" style="margin-top:10px">
                <button @onclick="AddCategory">Add category</button>
                <button disabled="@(selected == null || cats.IndexOf(selected) <= 0)" @onclick="() => Move(-1)" title="Higher priority: checked earlier (the list stays alphabetical; the priority number changes)" aria-label="Higher priority">↑</button>
                <button disabled="@(selected == null || cats.IndexOf(selected) >= cats.Count - 1)" @onclick="() => Move(1)" title="Lower priority: checked later (the list stays alphabetical; the priority number changes)" aria-label="Lower priority">↓</button>
                <button class="danger" disabled="@(selected == null)" @onclick="DeleteCategory">Delete</button>
            </p>
        </div>

        <div>
            @if (selected != null)
            {
                <section class="panel">
                    <h2>Category</h2>
                    <div class="field" style="margin-top:10px">
                        <input type="text" @ref="nameInput" placeholder="Name of the category (this becomes the folder name)" @bind="selected.Name" @bind:event="oninput" @bind:after="Edited" aria-label="Category (folder) name" />
                    </div>
                    <label class="inline"><input type="checkbox" checked="@selected.IgnoreCategoryInContent" @onchange="e => { selected.IgnoreCategoryInContent = (bool)e.Value!; Edited(); }" /> Don't use the name itself as a rule, only the rules below</label>

                    <h2 style="margin-top:18px">Rules</h2>
                    @foreach (var r in selected.Rules.ToList())
                    {
                        var error = RuleMatcher.Validate(r);
                        <div class="rule-line" style="margin-top:8px" @key="r">
                            <select @bind="r.Type" @bind:after="() => { TypeChanged(r); Edited(); Activate(r); }" aria-label="Rule type"><option value="Contains">Contains</option><option value="Regex">Regex</option><option value="All">All of</option></select>
                            @if (r.IsAll)
                            {
                                <span class="muted">Every term below must be found somewhere in the file: its name, a tag or the text read from the video (each in any of them).</span>
                            }
                            else
                            {
                                <input type="text" @bind="r.Value" @bind:event="oninput" @bind:after="Edited" @onfocus="() => Activate(r)" aria-label="Rule text" />
                            }
                            <button @onclick="() => { selected.Rules.Remove(r); Edited(); }" aria-label="Remove rule">Remove</button>
                        </div>
                        @if (r.IsAll)
                        {
                            <div class="term-list">
                                @foreach (var t in (r.Terms ??= new()).ToList())
                                {
                                    <div class="rule-line" @key="t">
                                        <select @bind="t.Type" @bind:after="() => { Edited(); ActivateTerm(t); }" aria-label="Term type"><option value="Contains">Contains</option><option value="Regex">Regex</option></select>
                                        <input type="text" @bind="t.Value" @bind:event="oninput" @bind:after="Edited" @onfocus="() => ActivateTerm(t)" aria-label="Term text" />
                                        <button @onclick="() => { r.Terms!.Remove(t); Edited(); }" aria-label="Remove term">Remove</button>
                                    </div>
                                }
                                <p><button @onclick="() => { r.Terms!.Add(new RuleTerm()); Edited(); }">Add a term</button></p>
                            </div>
                        }
                        @if (error != null) { <div class="rule-error">@(error[..1].ToUpper() + error[1..])</div> }
                    }
                    <p><button @onclick="() => { selected.Rules.Add(new Rule()); Edited(); }">Add rule</button></p>
                </section>
            }

            @if (App.Result != null && !edited)
            {
                <p><button @onclick='() => Nav.NavigateTo("scan")'>Scan again</button></p>
            }
        </div>

        @if (GuideOpen)
        {
            <RegexGuidePanel Value="@GuideValue" Tips="guideTips" OnClose="() => guideTarget = null" />
        }
    </div>
</div>

@if (toast != null)
{
    <div class="toast" role="status">@toast</div>
}

@code {
    private List<Category> cats = new();
    private Category? selected;
    private bool edited, savedOnce;
    private List<string> problems = new();
    private string filterText = "";
    private string? toast;
    private CancellationTokenSource? toastTimer;

    // The regex guide, beside the rule being edited
    private object? guideTarget;   // a Regex rule, or a Regex term of an "All of" rule
    private List<RegexTip> guideTips = new();
    private string GuideValue => guideTarget switch { Rule r => r.Value ?? "", RuleTerm t => t.Value ?? "", _ => "" };
    private bool GuideOpen => guideTarget != null && selected != null
        && selected.Rules.Any(r => ReferenceEquals(r, guideTarget) || (r.Terms != null && r.Terms.Any(t => ReferenceEquals(t, guideTarget))));

    // Becoming a rule with several terms: the text so far is the first term, and there is room for a second
    private void TypeChanged(Rule r)
    {
        if (r.IsAll && (r.Terms == null || r.Terms.Count == 0))
            r.Terms = new() { new RuleTerm("Contains", r.Value ?? ""), new RuleTerm("Contains", "") };
    }

    private void ActivateTerm(RuleTerm t)
    {
        if (!t.IsRegex) return;
        if (!GuideOpen) guideTips = RegexGuide.Tips(Working());
        guideTarget = t;
    }

    // Choosing Regex, or clicking in the text of a Regex rule, shows the guide for that rule
    private void Activate(Rule r)
    {
        if (!r.Type.Equals("Regex", StringComparison.OrdinalIgnoreCase)) return;
        if (!GuideOpen) guideTips = RegexGuide.Tips(Working());
        guideTarget = r;
    }

    protected override void OnInitialized()
    {
        Load();
        App.SettingsChanged += OnSaved;
        App.ResultChanged += OnResult;
    }

    private void OnSaved() => InvokeAsync(() => { if (!edited) { Load(); StateHasChanged(); } });
    private void OnResult() => InvokeAsync(StateHasChanged);

    private void Load()
    {
        string? keep = selected?.Name;
        cats = App.Settings.Clone().Categories;
        selected = cats.FirstOrDefault(c => c.Name == keep) ?? cats.OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase).FirstOrDefault();
        edited = false;
        problems = new();
    }

    private void Edited() => edited = true;

    private string FilesOf(Category c)
    {
        if (App.Result == null) return "";
        int n = App.Result.Decisions.Count(d => d.Category != null && d.Category.Equals(c.Name, StringComparison.OrdinalIgnoreCase));
        return n == 0 ? "no files" : Fmt.Plural(n, "file", "files");
    }

    // The settings as they are being edited (what Save would write); the options stay as they are
    private Settings Working()
    {
        var s = App.Settings.Clone();
        s.Categories = cats;
        return s;
    }

    // After Add the cursor goes to the name box: the name is typed at once (a category can't be saved before it has one)
    private ElementReference nameInput;
    private bool focusName;

    private bool scrollSelected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollSelected)
        {
            scrollSelected = false;
            try { await JS.InvokeVoidAsync("eval", "document.querySelector('.cat-item.selected')?.scrollIntoView({ block: 'nearest' })"); } catch (Exception) { }
        }
        if (!focusName) return;
        focusName = false;
        await nameInput.FocusAsync();
    }

    // Type-ahead in the list: letters and digits typed in a row (within a second) select the first category whose name starts with them
    private string typed = "";
    private DateTime typedAt = DateTime.MinValue;

    private void ListKey(KeyboardEventArgs e)
    {
        if (e.Key.Length != 1 || e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (DateTime.UtcNow - typedAt > TimeSpan.FromSeconds(1)) typed = "";
        typedAt = DateTime.UtcNow;
        var shown = CategoryFilter.Apply(cats, filterText).Select(h => h.Category).ToList();
        Category? Find(string prefix) => shown.FirstOrDefault(c => c.Name.StartsWith(prefix, StringComparison.CurrentCultureIgnoreCase));
        typed += e.Key;
        var hit = Find(typed);
        if (hit == null && typed.Length > 1) { typed = e.Key; hit = Find(typed); }   // nothing starts with all of it: a new search from this key
        if (hit != null) { selected = hit; scrollSelected = true; }
    }

    private void AddCategory()
    {
        filterText = "";   // the new category must be in the list
        var c = new Category { Name = "", IgnoreCategoryInContent = true, Rules = { new Rule() } };
        cats.Add(c);
        selected = c;
        focusName = true;
        Edited();
    }

    private void DeleteCategory()
    {
        if (selected == null) return;
        var sorted = cats.OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        int at = sorted.IndexOf(selected);
        cats.Remove(selected);
        sorted.Remove(selected);
        selected = sorted.Count == 0 ? null : sorted[Math.Min(at, sorted.Count - 1)];
        Edited();
    }

    private void Move(int by)
    {
        if (selected == null) return;
        int at = cats.IndexOf(selected), to = at + by;
        if (to < 0 || to >= cats.Count) return;
        cats.RemoveAt(at);
        cats.Insert(to, selected);
        Edited();
    }

    private void Save()
    {
        problems = App.SaveSettings(Working());
        if (problems.Count > 0) return;
        savedOnce = true;
        edited = false;
        ShowToast(App.Result != null ? "Saved. The files of the last scan were sorted again with the new rules." : "Saved.");
        Load();
    }

    private void Revert() => Load();

    private void ShowToast(string text)
    {
        toast = text;
        toastTimer?.Cancel();
        toastTimer = new CancellationTokenSource();
        var token = toastTimer.Token;
        _ = Task.Delay(5000, token).ContinueWith(t => { if (t.IsCanceled) return; toast = null; InvokeAsync(StateHasChanged); });
    }

    public void Dispose()
    {
        App.SettingsChanged -= OnSaved;
        App.ResultChanged -= OnResult;
        toastTimer?.Cancel();
    }
}

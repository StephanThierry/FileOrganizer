@page "/unmatched"
@implements IDisposable
@inject AppController App
@inject NavigationManager Nav

<PageTitle>Unmatched</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1>Unmatched</h1>
            <p>@(App.Result == null ? "Files that no rule matched are listed here, with the text that was found in them." : rows.Count > 0 ? $"{Fmt.Plural(rows.Count, "file", "files")} matched nothing. Click a text to make a rule from it, or choose a folder for the file." : "Every file has a category.")</p>
        </div>
    </div>

    @if (App.Result == null)
    {
        <div class="empty">
            <h2>Nothing scanned yet</h2>
            <button class="primary big" @onclick='() => Nav.NavigateTo("scan")'>Go to scan</button>
        </div>
    }
    else if (rows.Count == 0)
    {
        <div class="empty">
            <h2>Every file has a category</h2>
            <button class="primary big" @onclick='() => Nav.NavigateTo("")'>Review the moves</button>
        </div>
    }
    else
    {
        <div class="fo-list">
            @foreach (var d in rows.Take(shown))
            {
                <div class="un-row" @key="d">
                    <div class="fo-thumbs">
                        @if (d.IsVideo)
                        {
                            @for (int part = 0; part < 3; part++) { <Thumb Decision="d" Index="IndexOf(d)" Part="part" /> }
                        }
                        else { <Thumb Decision="d" Index="IndexOf(d)" /> }
                    </div>
                    <div class="info">
                        <button class="namelink" title="Make a rule from the file name" @onclick="() => OpenRule(System.IO.Path.GetFileNameWithoutExtension(d.FileName), null, d)">@d.FileName</button>
                        @if (d.SubFolder.Length > 0) { <div class="muted">in @d.SubFolder</div> }
                        <div class="chips">
                            @if (d.Title.Length > 0) { <span class="chip-wrap">@Tick(d, d.Title)<button class="chip btn" @onclick="() => OpenRule(d.Title, null, d)"><small>Title tag</small>@d.Title</button></span> }
                            @if (d.Comment.Length > 0) { <span class="chip-wrap">@Tick(d, d.Comment)<button class="chip btn" @onclick="() => OpenRule(d.Comment, null, d)"><small>Comment tag</small>@d.Comment</button></span> }
                            @* One tag per text on screen, however many different ways the frames read it: all the readings are kept, to choose a rule from *@
                            @foreach (var f in OcrText.Findings(d.OcrLines).Where(f => f.Best.Any(char.IsLetter)))
                            {
                                <span class="chip-wrap">@Tick(d, f.Best)<button class="chip btn" title="@VariantsTip(f)" @onclick="() => OpenRule(f.Best, f.Variants, d)">@(f.Best)@if (f.Variants.Count > 1) { <small class="muted"> @f.Variants.Count variants</small> }</button></span>
                            }
                            @if (d.OcrCorrupt) { <span class="muted">The video can't be read.</span> }
                        </div>
                        @if (Ticked(d).Count >= 2)
                        {
                            <div class="un-all"><button @onclick="() => OpenAllRule(d)">Make one rule from the @Ticked(d).Count ticked texts (all must be found)</button></div>
                        }
                    </div>
                    <div class="un-side">
                    <select value="@d.Choice" @onchange="e => Assign(d, e.Value!.ToString()!)" aria-label="Where @d.FileName goes">
                        <option value="@FileDecision.LeaveHere">@FileDecision.LeaveHere</option>
                        @foreach (var c in App.CategoryNames()) { <option value="@c">@c</option> }
                    </select>
                    <button class="icon" disabled="@(d.EffectiveCategory == null)" @onclick="() => MoveOne(d)" title="Move this file now (to the folder chosen here; nothing is overwritten)" aria-label="Move @d.FileName now"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 11v-3H8v-2h4V9l4 4-4 4z" fill="currentColor" /></svg></button>
                    <button class="icon del" @onclick="() => deleting = d" title="Delete the file (asks first)" aria-label="Delete @d.FileName"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="currentColor" /></svg></button>
                    </div>
                </div>
            }
        </div>
        @if (rows.Count > shown)
        {
            <div class="more"><button @onclick="() => shown += 100">Show more</button></div>
        }
    }
</div>

@if (ruleOpen)
{
    <div class="dialog-backdrop" @onclick="() => ruleOpen = false">
        <div class="dialog-row" @onclick:stopPropagation="true">
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="rule-title">
            <h2 id="rule-title">Make a rule</h2>
            <div class="rule-line" style="margin-top:14px">
                <select @bind="ruleType" @bind:after="TypeChanged" aria-label="Rule type"><option value="Contains">Contains</option><option value="Regex">Regex</option><option value="All">All of</option></select>
                @if (ruleType == "All") { <span class="muted">All of these must be found in the file. Each is text or a pattern (R.?C finds REC, R3C and RC).</span> }
                else { <input type="text" @bind="ruleText" @bind:event="oninput" @bind:after="Preview" @onfocus="ShowGuideIfRegex" aria-label="Text to look for" /> }
                <span></span>
            </div>
            @if (ruleType == "All")
            {
                @foreach (var t in ruleTerms.ToList())
                {
                    <div class="rule-line" @key="t">
                        <select @bind="t.Type" @bind:after="() => { Preview(); ActivateTerm(t); }" aria-label="Term type"><option value="Contains">Contains</option><option value="Regex">Regex</option></select>
                        <input type="text" @bind="t.Value" @bind:event="oninput" @bind:after="Preview" @onfocus="() => ActivateTerm(t)" aria-label="Term text" />
                        <button @onclick="() => { ruleTerms.Remove(t); Preview(); }" aria-label="Remove term">Remove</button>
                    </div>
                }
                <p><button @onclick="() => { ruleTerms.Add(new RuleTerm()); Preview(); }">Add a term</button></p>
            }
            @if (ShowVariants)
            {
                @* Every different way the text was read: which of them would the rule catch? Click one to use it as the text. *@
                <div class="variants">
                    <strong>Read in the video as</strong>
                    <div class="variant-list">
                        @foreach (var v in ruleVariants)
                        {
                            bool hit = Caught(v);
                            <div class="variant">
                                <span class="@(hit ? "ok-text" : "warn-text")" aria-label="@(hit ? "caught by the rule" : "not caught by the rule")">@(hit ? "\u2713" : "\u2717")</span>
                                <button class="chip btn" disabled="@(ruleType == "All")" title="Use this reading as the text of the rule" @onclick="() => UseVariant(v)">@v.Text</button>
                                @if (v.Count > 1) { <span class="muted">@(v.Count)x</span> }
                            </div>
                        }
                    </div>
                    <p class="muted">@VariantSummary()</p>
                </div>
            }
            <div class="rule-line">
                <select @bind="ruleCategory" @bind:after="PickCategory" aria-label="Category">
                    <option value="@NewChoice">+ A new category (type its name below)</option>
                    @foreach (var c in App.CategoryNames()) { <option value="@c">@c</option> }
                </select>
                <input type="text" placeholder="Name of the new category (a new folder)" @bind="newCategory" @bind:event="oninput" @bind:after="TypeCategory" aria-label="New category" />
                <span></span>
            </div>
            <p class="@(previewBad ? "warn-text" : "")" aria-live="polite">@preview</p>
            <div class="buttons">
                <button @onclick="() => ruleOpen = false">Cancel</button>
                <button class="primary" disabled="@(!canAdd)" @onclick="AddRule">Add the rule</button>
            </div>
        </div>
        @if (GuideVisible)
        {
            <RegexGuidePanel Value="@GuideValue" Tips="guideTips" InitialText="@ruleFileName" OnClose="() => guideDismissed = true" />
        }
        </div>
    </div>
}

<DeleteFileDialog Decision="deleting" OnCancel="() => deleting = null" OnDone="Deleted" />

@if (toast != null)
{
    <div class="toast" role="status">@toast</div>
}

@code {
    private List<FileDecision> rows = new();
    private Dictionary<FileDecision, int> index = new();
    private int shown = 100;
    private bool ruleOpen, previewBad, canAdd;
    private string ruleText = "", ruleType = "Contains", ruleCategory = "", newCategory = "", preview = "";
    private string? toast;
    private FileDecision? deleting;
    private CancellationTokenSource? toastTimer;

    protected override void OnInitialized()
    {
        Load();
        App.ResultChanged += OnResult;
    }

    private void OnResult() => InvokeAsync(() => { Load(); StateHasChanged(); });

    private void Load()
    {
        var decisions = App.Result?.Decisions ?? new List<FileDecision>();
        index = new Dictionary<FileDecision, int>();
        for (int i = 0; i < decisions.Count; i++) index[decisions[i]] = i;
        rows = decisions.Where(d => d.IsUnmatched).ToList();
    }

    private void Deleted((bool Ok, string Message) result)
    {
        deleting = null;
        ShowToast(result.Message, result.Ok ? 6000 : 10000);
    }

    private int IndexOf(FileDecision d) => index.TryGetValue(d, out var i) ? i : -1;

    // A folder chosen by hand: the file stays here until the move icon is clicked (it is also listed in Review as waiting to move)
    private void Assign(FileDecision d, string choice)
    {
        d.Choose(choice);
        App.NotifyDecisionsEdited();
    }

    // The move icon: moves just this file now (nothing is overwritten); it then leaves this list
    private void MoveOne(FileDecision d)
    {
        var report = App.MoveOne(d, alsoRename: false);
        string text = report.Summary;
        if (report.Messages.Count > 0) text += " " + string.Join(" ", report.Messages.Take(2));
        ShowToast(text, report.Messages.Count > 0 ? 10000 : 5000);
    }

    // The texts ticked per file, for one rule that needs all of them
    private readonly Dictionary<FileDecision, HashSet<string>> ticked = new();
    private List<RuleTerm> ruleTerms = new();

    private HashSet<string> Ticked(FileDecision d) => ticked.TryGetValue(d, out var set) ? set : new();

    private Microsoft.AspNetCore.Components.RenderFragment Tick(FileDecision d, string text) => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "type", "checkbox");
        builder.AddAttribute(2, "checked", Ticked(d).Contains(text));
        builder.AddAttribute(3, "title", "Tick this text, and another one, to make one rule that needs all of them");
        builder.AddAttribute(4, "aria-label", "Tick " + text);
        builder.AddAttribute(5, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e =>
        {
            if (!ticked.TryGetValue(d, out var set)) ticked[d] = set = new();
            if (e.Value is true) set.Add(text); else set.Remove(text);
        }));
        builder.CloseElement();
    };

    // The different readings of the text(s) the rule is made from (the same text in other capitals counts once)
    private List<OcrVariant> ruleVariants = new();
    private bool ShowVariants => ruleType == "All" ? ruleVariants.Count > 0 : ruleVariants.Count > 1;

    private void SetVariants(IEnumerable<OcrVariant> variants) =>
        ruleVariants = variants.GroupBy(v => v.Text, StringComparer.OrdinalIgnoreCase).Select(g => g.First()).ToList();

    private static string VariantsTip(OcrFinding f) =>
        "Read as:\n" + string.Join("\n", f.Variants.Select(v => v.Count > 1 ? $"{v.Text}   ({v.Count}x)" : v.Text)) + "\n\nClick to see which rule fits them all.";

    private IReadOnlyList<OcrVariant> VariantsFor(FileDecision d, string text) =>
        OcrText.Findings(d.OcrLines).FirstOrDefault(f => f.Best == text)?.Variants ?? new[] { new OcrVariant(text, 1) };

    private Rule CurrentRule() => ruleType == "All" ? Rule.AllOf(ruleTerms) : new Rule(ruleType, ruleText.Trim());

    // Would the rule being made catch this reading? (A rule with several terms: would one of its terms.)
    private bool Caught(OcrVariant v)
    {
        var rule = CurrentRule();
        if (RuleMatcher.Validate(rule) != null) return false;
        if (ruleType == "All") return ruleTerms.Any(t => RuleMatcher.AllOfMatches(Rule.AllOf(new[] { t }), new[] { v.Text }));
        return RuleMatcher.Match(v.Text, new Settings { Categories = { new Category { Name = "x", IgnoreCategoryInContent = true, Rules = { rule } } } }) != null;
    }

    private string VariantSummary()
    {
        if (RuleMatcher.Validate(CurrentRule()) != null) return "";
        int caught = ruleVariants.Count(Caught);
        return ruleType == "All" ? $"The terms catch {caught} of the {ruleVariants.Count} readings." : $"This rule catches {caught} of the {ruleVariants.Count} readings.";
    }

    private void UseVariant(OcrVariant v)
    {
        if (ruleType == "All") return;
        ruleText = v.Text;
        Preview();
    }

    // The file the rule is made from: the regex guide's test box starts with its name
    private string ruleFileName = "";

    private void OpenAllRule(FileDecision d)
    {
        ruleFileName = d.FileName;
        guideTerm = null; guideDismissed = false;
        SetVariants(Ticked(d).SelectMany(t => VariantsFor(d, t)));
        ruleTerms = Ticked(d).Select(t => new RuleTerm("Contains", t)).ToList();
        ruleText = "";
        ruleType = "All";
        newCategory = "";
        ruleCategory = App.CategoryNames().FirstOrDefault() ?? NewChoice;
        ruleOpen = true;
        Preview();
    }

    // Becoming a rule with several terms: the text so far is the first term, and there is room for a second
    private void TypeChanged()
    {
        if (ruleType == "All" && ruleTerms.Count == 0) ruleTerms = new() { new RuleTerm("Contains", ruleText.Trim()), new RuleTerm("Contains", "") };
        guideTerm = null;
        if (ruleType == "Regex") ShowGuide();
        Preview();
    }

    // The regex guide, to the right of the dialog while a pattern is being made: for the text of a Regex rule, or for a Regex term of "All of"
    private List<RegexTip> guideTips = new();
    private RuleTerm? guideTerm;
    private bool guideDismissed;
    private bool GuideVisible => ruleOpen && !guideDismissed && (ruleType == "Regex" || (ruleType == "All" && guideTerm != null && ruleTerms.Contains(guideTerm)));
    private string GuideValue => ruleType == "Regex" ? ruleText : guideTerm?.Value ?? "";

    private void ShowGuide()
    {
        guideDismissed = false;
        guideTips = RegexGuide.Tips(App.Settings);
    }

    private void ShowGuideIfRegex() { if (ruleType == "Regex" && !GuideVisible) ShowGuide(); }

    private void ActivateTerm(RuleTerm t)
    {
        if (!t.IsRegex) return;
        guideTerm = t;
        if (!GuideVisible) ShowGuide();
    }

    private void OpenRule(string text, IReadOnlyList<OcrVariant>? variants, FileDecision from)
    {
        ruleFileName = from.FileName;
        guideTerm = null; guideDismissed = false;
        SetVariants(variants ?? new[] { new OcrVariant(text, 1) });
        ruleTerms = new();
        ruleText = text;
        ruleType = "Contains";
        newCategory = "";
        ruleCategory = App.CategoryNames().FirstOrDefault() ?? NewChoice;   // the first category, or "a new category" when there is none
        ruleOpen = true;
        Preview();
    }

    // The first entry of the list: the rule goes to a new category, named in the box below the list
    private const string NewChoice = "@@new-category@@";
    private bool IsNew => ruleCategory == NewChoice;
    private string Category => IsNew ? newCategory.Trim() : ruleCategory;

    // An existing category was chosen: the typed name is forgotten
    private void PickCategory() { if (!IsNew) newCategory = ""; Preview(); }

    // Typing a name means "a new category"
    private void TypeCategory() { if (newCategory.Trim().Length > 0) ruleCategory = NewChoice; Preview(); }

    // How many of the files here would this rule catch?
    private void Preview()
    {
        string text = ruleText.Trim(), category = Category;
        var rule = ruleType == "All" ? Rule.AllOf(ruleTerms) : new Rule(ruleType, text);
        var error = RuleMatcher.Validate(rule);
        previewBad = error != null;
        canAdd = error == null && category.Length > 0 && FolderNames.IsSafe(category);
        if (error != null) { preview = ruleType != "All" && text.Length == 0 ? "Type the text to look for." : error[..1].ToUpper() + error[1..]; return; }
        var trial = new Settings { Categories = { new Category { Name = "x", IgnoreCategoryInContent = true, Rules = { rule } } } };
        // A rule with several terms looks at everything known about the file together; the others at one text at a time
        int hits = rows.Count(d => ruleType == "All"
            ? RuleMatcher.AllOfMatches(rule, new[] { d.FileName, d.Title, d.Comment }.Concat(d.OcrLines).ToList())
            : RuleMatcher.Match(d.FileName, trial) != null || RuleMatcher.Match(d.Title, trial) != null
              || RuleMatcher.Match(d.Comment, trial) != null || d.OcrLines.Any(l => RuleMatcher.Match(l, trial) != null));
        preview = category.Length == 0 ? (IsNew ? "Type the name of the new category (a new folder) in the box below the list." : "Choose a category, or name a new one.")
            : !FolderNames.IsSafe(category) ? $"\"{category}\" can't be a folder name."
            : $"Would match {hits:N0} of the {rows.Count:N0} files here, and send them to {category}{(IsNew ? " (a new category)" : "")}.";
    }

    private void AddRule()
    {
        string message = ruleType == "All"
            ? App.AddAllRule(Category, ruleTerms, out bool ok)
            : App.AddRule(Category, ruleType, ruleText, out ok);
        ShowToast(message, ok ? 5000 : 9000);
        if (ok) ruleOpen = false;
    }

    private void ShowToast(string text, int ms)
    {
        toast = text;
        toastTimer?.Cancel();
        toastTimer = new CancellationTokenSource();
        var token = toastTimer.Token;
        _ = Task.Delay(ms, token).ContinueWith(t => { if (t.IsCanceled) return; toast = null; InvokeAsync(StateHasChanged); });
    }

    public void Dispose()
    {
        App.ResultChanged -= OnResult;
        toastTimer?.Cancel();
    }
}

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileOrganizer.Desktop.ViewModels"
             x:Class="FileOrganizer.Desktop.Views.UnmatchedView"
             x:DataType="vm:UnmatchedViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.rows ListBoxItem"><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Border.frow"><Setter Property="Background" Value="{DynamicResource Sheet}"/><Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style Selector="Button.chip"><Setter Property="Padding" Value="10,3"/><Setter Property="CornerRadius" Value="12"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentWash}"/></Style>
    <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="{DynamicResource Grease}"/></Style>
    <Style Selector="Image.thumb"><Setter Property="Width" Value="192"/><Setter Property="Height" Value="108"/></Style>
    <Style Selector="Button.icon.del"><Setter Property="Foreground" Value="{DynamicResource Grease}"/></Style>
    <Style Selector="Button.icon.del:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource GreaseHover}"/><Setter Property="Background" Value="{DynamicResource GreaseWash}"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="12,16,12,12">
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="Unmatched"/>
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Files that no rule caught, with the tags and the text found in them. Click a text to make a rule from it: the files it catches go to Review at once."/>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,0,0,10" IsVisible="{Binding HasResult}"/>

    <Border Grid.Row="2" Classes="panel" Padding="40" VerticalAlignment="Top" IsVisible="{Binding !HasResult}">
      <StackPanel HorizontalAlignment="Center" Spacing="10">
        <TextBlock Classes="h2" Text="Nothing scanned yet" HorizontalAlignment="Center"/>
        <TextBlock Classes="muted" Text="Scan a folder first. The files no rule matched are listed here." HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Go to scan" Command="{Binding GoToScanCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Classes="panel" Padding="40" VerticalAlignment="Top">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasResult"/>
          <Binding Path="!HasRows"/>
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel HorizontalAlignment="Center" Spacing="10">
        <TextBlock Classes="h2" Text="Every file has a category" HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Review the moves" Command="{Binding GoToReviewCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasRows}">
      <ListBox Classes="rows" ItemsSource="{Binding Rows}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:UnmatchedRow">
            <Border Classes="frow">
              <Grid ColumnDefinitions="606,40,*,252" ColumnSpacing="12">
                <!-- Three pictures spread over the video; other files get a file icon -->
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsVideo}">
                  <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" ClipToBounds="True"><Image Classes="thumb" Source="{Binding Thumb1}" Stretch="UniformToFill"/></Border>
                  <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" ClipToBounds="True"><Image Classes="thumb" Source="{Binding Thumb2}" Stretch="UniformToFill"/></Border>
                  <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" ClipToBounds="True"><Image Classes="thumb" Source="{Binding Thumb3}" Stretch="UniformToFill"/></Border>
                </StackPanel>
                <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding !IsVideo}">
                  <PathIcon Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z" Foreground="{DynamicResource Muted}" Width="26" Height="26"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,22,0,0">
                  <Button Classes="icon" Command="{Binding PlayFileCommand}" ToolTip.Tip="Open it (in the default player)">
                    <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"/>
                  </Button>
                  <Button Classes="icon del" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the file (to the Recycle Bin, asks first)" AutomationProperties.Name="Delete the file">
                      <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="No text was found in the file name, the tags or the video." Classes="muted small" IsVisible="{Binding !HasLines}"/>
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextLine">
                        <Button Classes="chip" Command="{Binding Command}" ToolTip.Tip="Make a rule from this text">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" IsVisible="{Binding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Top">
                  <TextBlock Text="Or send it to" Classes="muted small"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch"/>
                    <!-- Move just this file now: it waits for this click after a folder is chosen -->
                    <Button Grid.Column="1" Classes="icon" Command="{Binding MoveCommand}" IsEnabled="{Binding CanMove}" VerticalAlignment="Center"
                            ToolTip.Tip="Move this file now (to the folder chosen here; nothing is overwritten)" AutomationProperties.Name="Move this file now">
                      <Path Data="M20,6 L12,6 L10,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 Z M12,17 L12,14 L8,14 L8,12 L12,12 L12,9 L16,13 Z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Toast -->
    <Border Grid.Row="2" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource Ink}" CornerRadius="4" Padding="14,10" Margin="0,0,0,20"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="760">
      <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Sheet}" TextWrapping="Wrap"/>
    </Border>

    <!-- Make a rule -->
    <Grid Grid.RowSpan="3" Margin="-12,-16,-12,-12" Background="#80000000" IsVisible="{Binding RuleVisible}">
      <Border Classes="panel" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Make a rule"/>
          <StackPanel Spacing="4">
            <TextBlock Text="When the text contains" FontWeight="SemiBold"/>
            <TextBox Text="{Binding RuleText}" AcceptsReturn="False"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
              <ComboBox ItemsSource="{Binding RuleTypes}" SelectedItem="{Binding RuleType}" MinWidth="150"/>
              <TextBlock Classes="muted small" VerticalAlignment="Center" Text="Contains: the text as it is. Regex: a pattern, e.g. S\d\dE\d\d"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="...the file goes to" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding RuleCategories}" SelectedItem="{Binding RuleCategory}" HorizontalAlignment="Stretch" IsEnabled="{Binding !HasNewCategory}"/>
            <TextBox Text="{Binding NewCategory}" PlaceholderText="...or the name of a new category (a new folder)"/>
          </StackPanel>
          <Border Background="{DynamicResource Table}" CornerRadius="6" Padding="12,10">
            <TextBlock Text="{Binding RulePreview}" TextWrapping="Wrap" Classes.bad="{Binding RulePreviewBad}"/>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelRuleCommand}"/>
            <Button Classes="primary" Content="Add the rule" Command="{Binding AddRuleCommand}" IsEnabled="{Binding CanAddRule}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <!-- Confirmation before deleting -->
    <Grid Grid.RowSpan="3" Margin="-12,-16,-12,-12" Background="#80000000" IsVisible="{Binding ConfirmVisible}">
      <Border Classes="panel" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding ConfirmTitle}" TextWrapping="Wrap"/>
          <TextBlock Classes="muted" Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding ConfirmNoCommand}"/>
            <Button Classes="danger" Content="{Binding ConfirmButton}" Command="{Binding ConfirmYesCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
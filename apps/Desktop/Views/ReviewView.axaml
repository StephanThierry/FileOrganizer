<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileOrganizer.Desktop.ViewModels"
             x:Class="FileOrganizer.Desktop.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.empty"><Setter Property="Foreground" Value="{DynamicResource Keep}"/></Style>
    <Style Selector="TextBlock.left"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="ListBox.rows ListBoxItem"><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Border.frow"><Setter Property="Background" Value="{DynamicResource Sheet}"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style Selector="Border.frow:pointerover"><Setter Property="Background" Value="{DynamicResource Table}"/></Style>
    <Style Selector="Border.frow.done"><Setter Property="Opacity" Value="0.5"/></Style>
    <Style Selector="Border.sourcechip"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="8,1"/></Style>
    <Style Selector="Border.donechip"><Setter Property="Background" Value="{DynamicResource KeepWash}"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="8,1"/></Style>
    <Style Selector="Image.thumb"><Setter Property="Width" Value="192"/><Setter Property="Height" Value="108"/></Style>
    <Style Selector="Button.icon.del"><Setter Property="Foreground" Value="{DynamicResource Grease}"/></Style>
    <Style Selector="Button.icon.del:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource GreaseHover}"/><Setter Property="Background" Value="{DynamicResource GreaseWash}"/></Style>
  </UserControl.Styles>

  <!-- Fixed column widths: the rows are created as they scroll into view, and content-sized columns shared with the header would
       change width with whichever rows exist (an endless layout loop in Avalonia) -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,16,12,0">
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="Review"/>
      <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Where each file will go, and why. Choose another folder for a file, or leave it where it is. Then move the files now, or write a script and run it yourself."/>
    </StackPanel>

    <StackPanel Grid.Row="1">
      <Border IsVisible="{Binding HasScripts}" Background="{DynamicResource KeepWash}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
        <StackPanel Spacing="6">
          <SelectableTextBlock Text="{Binding ScriptsText}" TextWrapping="Wrap"/>
          <Button Content="Open the folder" Command="{Binding OpenScriptsFolderCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <WrapPanel Grid.Row="2" Margin="0,0,0,10" IsVisible="{Binding HasRows}">
      <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="230" Margin="0,0,16,6"/>
      <TextBox Text="{Binding Search}" PlaceholderText="Filter by file name or rule" Width="280" Margin="0,0,16,6"/>
      <CheckBox IsChecked="{Binding AlsoRename}" IsVisible="{Binding HasRenames}" Content="Also rename files from their title or comment tag" Margin="0,0,16,6"/>
      <Button Content="Status" Command="{Binding OpenStatusCommand}" IsVisible="{Binding HasLeftovers}" Margin="0,0,16,6"
              ToolTip.Tip="What is left in the folders that were opened"/>
      <CheckBox IsChecked="{Binding ConfirmDelete}" Content="Delete confirmation" Margin="0,0,0,6"
                ToolTip.Tip="On: deleting a file asks first. Off: the delete icon deletes the file at once, without asking."/>
    </WrapPanel>

    <!-- Nothing scanned yet -->
    <Border Grid.Row="3" Classes="panel" Padding="40" VerticalAlignment="Top" IsVisible="{Binding !HasResult}">
      <StackPanel HorizontalAlignment="Center" Spacing="10">
        <TextBlock Classes="h2" Text="Nothing to review yet" HorizontalAlignment="Center"/>
        <TextBlock Classes="muted" Text="Scan a folder first. The files that match a rule are listed here." HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Go to scan" Command="{Binding GoToScanCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" Classes="panel" Padding="40" VerticalAlignment="Top">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasResult"/>
          <Binding Path="!HasRows"/>
        </MultiBinding>
      </Border.IsVisible>
      <StackPanel HorizontalAlignment="Center" Spacing="10">
        <TextBlock Classes="h2" Text="No file matched a rule" HorizontalAlignment="Center"/>
        <TextBlock Classes="muted" Text="Look at the unmatched files and make rules from the text that was found in them." HorizontalAlignment="Center"/>
        <Button Classes="primary" Content="Look at the unmatched files" Command="{Binding GoToUnmatchedCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasRows}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Table}" Padding="12,6,32,6">
          <Grid ColumnDefinitions="606,40,*,252" ColumnSpacing="12">
            <TextBlock Grid.Column="2" Text="File, and why it matches" Classes="muted small" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Goes to" Classes="muted small" FontWeight="SemiBold"/>
          </Grid>
        </Border>
        <ListBox Classes="rows" ItemsSource="{Binding Rows}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileRow">
              <Border Classes="frow" Classes.done="{Binding IsDone}">
                <Grid ColumnDefinitions="606,40,*,252" ColumnSpacing="12">
                  <!-- Three pictures spread over the video; other files get a file icon -->
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding IsVideo}">
                    <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" ClipToBounds="True"><Image Classes="thumb" Source="{Binding Thumb1}" Stretch="UniformToFill"/></Border>
                    <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" ClipToBounds="True"><Image Classes="thumb" Source="{Binding Thumb2}" Stretch="UniformToFill"/></Border>
                    <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" ClipToBounds="True"><Image Classes="thumb" Source="{Binding Thumb3}" Stretch="UniformToFill"/></Border>
                  </StackPanel>
                  <Border Background="{DynamicResource Frame}" CornerRadius="3" Width="192" Height="108" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding !IsVideo}">
                    <PathIcon Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z" Foreground="{DynamicResource Muted}" Width="26" Height="26"/>
                  </Border>
                  <!-- Play: opens the file in the default player -->
                  <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Classes="icon" Command="{Binding PlayFileCommand}" ToolTip.Tip="Open it (in the default player)">
                      <Path Data="M3,1.5 L3,12.5 L12,7 Z" Fill="{Binding $parent[Button].Foreground}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="icon del" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the file (to the Recycle Bin; asks first unless Delete confirmation is off)" AutomationProperties.Name="Delete the file">
                      <Path Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FromFolderText}" Classes="muted small" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasFromFolder}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="sourcechip"><TextBlock Text="{Binding SourceText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/></Border>
                      <TextBlock Text="{Binding Trigger}" Classes="muted small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RenameText}" IsVisible="{Binding HasRename}" Classes="small" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" IsEnabled="{Binding !IsDone}" HorizontalAlignment="Stretch"/>
                      <!-- Move just this file now -->
                      <Button Grid.Column="1" Classes="icon" Command="{Binding MoveCommand}" IsEnabled="{Binding CanMove}" VerticalAlignment="Center"
                              ToolTip.Tip="Move this file now (to the folder chosen here; nothing is overwritten)" AutomationProperties.Name="Move this file now">
                        <Path Data="M20,6 L12,6 L10,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 Z M12,17 L12,14 L8,14 L8,12 L12,12 L12,9 L16,13 Z" Fill="{Binding $parent[Button].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                      </Button>
                    </Grid>
                    <Border Classes="donechip" IsVisible="{Binding IsDone}" HorizontalAlignment="Left"><TextBlock Text="Moved" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Keep}"/></Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Row="4" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="16,12" Margin="-12,12,-12,0" IsVisible="{Binding HasResult}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Create scripts" Command="{Binding CreateScriptsCommand}" FontSize="15" Padding="18,8"
                  ToolTip.Tip="Writes move_files (and rename_files, unmatched_files.txt) in the scanned folder, to run yourself"/>
          <Button Classes="primary" Content="Move files now" Command="{Binding AskMoveCommand}" IsEnabled="{Binding HasPending}" FontSize="15" Padding="18,8"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Detail}" Classes="muted" VerticalAlignment="Bottom"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Toast: overlay inside the bottom bar's area -->
    <Border Grid.Row="4" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource Ink}" CornerRadius="4" Padding="14,10" Margin="0,12,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
      <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Sheet}" TextWrapping="Wrap"/>
    </Border>

    <!-- Status: what is left in the folders that were opened (Process folders), with the option to delete the empty ones -->
    <Grid Grid.RowSpan="5" Margin="-12,-16,-12,0" Background="#80000000" IsVisible="{Binding StatusVisible}">
      <Border Classes="panel" Width="920" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="Status"/>
            <TextBlock Text="{Binding StatusHeadline}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusNote}" IsVisible="{Binding HasStatusNote}" TextWrapping="Wrap" Classes="muted"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="danger" Content="Delete empty folders" Command="{Binding DeleteEmptyFoldersCommand}" IsEnabled="{Binding CanDeleteEmpty}"
                      ToolTip.Tip="Deletes the folders with no file left in them (and their empty sub-folders) from the drive, and takes them out of this list"/>
              <Button Content="Close" Command="{Binding CloseStatusCommand}"/>
            </StackPanel>
          </StackPanel>
          <!-- A compact table: one line per folder that was opened -->
          <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="{DynamicResource Table}" Padding="12,6,12,6">
                <Grid ColumnDefinitions="2*,70,80,90,3*" ColumnSpacing="12">
                  <TextBlock Text="Folder" Classes="muted small" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="Files left" Classes="muted small" FontWeight="SemiBold" TextAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="Size" Classes="muted small" FontWeight="SemiBold" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Status" Classes="muted small" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="4" Text="What is left" Classes="muted small" FontWeight="SemiBold"/>
                </Grid>
              </Border>
              <ScrollViewer MaxHeight="360">
                <ItemsControl ItemsSource="{Binding StatusRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusRow">
                      <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="12,6">
                        <Grid ColumnDefinitions="2*,70,80,90,3*" ColumnSpacing="12">
                          <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Left}" TextAlignment="Right"/>
                          <TextBlock Grid.Column="2" Text="{Binding Size}" TextAlignment="Right"/>
                          <TextBlock Grid.Column="3" Text="{Binding Status}" FontWeight="SemiBold" Classes.empty="{Binding IsEmpty}" Classes.left="{Binding HasFiles}"/>
                          <TextBlock Grid.Column="4" Text="{Binding Details}" Classes="muted small" TextWrapping="Wrap" ToolTip.Tip="{Binding Details}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Confirmation before moving -->
    <Grid Grid.RowSpan="5" Margin="-12,-16,-12,0" Background="#80000000" IsVisible="{Binding ConfirmVisible}">
      <Border Classes="panel" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding ConfirmTitle}" TextWrapping="Wrap"/>
          <TextBlock Classes="muted" Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding ConfirmNoCommand}"/>
            <Button Classes="primary" Content="{Binding ConfirmButton}" Command="{Binding ConfirmYesCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileOrganizer.Desktop.ViewModels"
             x:Class="FileOrganizer.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="{DynamicResource Keep}"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="12,16,12,0">
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="Settings"/>
      <!-- Where the program keeps its files, shown at the top like in the other programs of the family -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <TextBlock Classes="muted" Text="Data folder:" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DataFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip.Tip="settings.json, the pictures and the OCR models are kept here"/>
        <Button Classes="link" Content="Open" Command="{Binding OpenDataCommand}" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Classes="gutter">
      <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Videos: the text scan"/>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Files of these types are read frame by frame to find text (logos, website names, titles) when the name and the tags matched nothing."/>
            <ItemsControl ItemsSource="{Binding Extensions}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExtensionItem"><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Extension}" Margin="0,0,16,0"/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding NewExtension}" PlaceholderText=".webm" Width="140"/>
              <Button Content="Add a file type" Command="{Binding AddExtensionCommand}"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding StopAtFirstMatch}" Content="Stop reading a video as soon as one frame has text that matches a rule" Margin="0,6,0,0"/>
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Faster. Switch it off to read all the frames of every video, which finds more text for the unmatched list but takes longer."/>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Text recognition (OCR)"/>
            <TextBlock Text="{Binding ModelsText}" TextWrapping="Wrap" Classes.ok="{Binding ModelsReady}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="muted" Text="Models folder:" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ModelsFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
              <Button Classes="link" Content="Open" Command="{Binding OpenModelsCommand}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="To work offline, put ch_PP-OCRv5_det_mobile.onnx and latin_PP-OCRv5_rec_mobile.onnx in that folder. The program needs at least 2 CPU cores for this."/>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="Scripts"/>
            <TextBlock TextWrapping="Wrap">
              <Run Text="On this computer the move and rename scripts are "/><Run Text="{Binding ScriptKind}" FontWeight="SemiBold"/><Run Text=". They never overwrite a file, and work with network paths."/>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="16,12" Margin="-12,12,-12,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
          <Button Content="Undo the changes" Command="{Binding RevertCommand}" IsEnabled="{Binding IsEdited}"/>
          <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsEdited}" FontSize="15" Padding="18,8"/>
        </StackPanel>
        <TextBlock VerticalAlignment="Center" Text="You have changes that are not saved yet." IsVisible="{Binding IsEdited}"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource Ink}" CornerRadius="4" Padding="14,10" Margin="0,0,0,90"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="760">
      <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Sheet}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>

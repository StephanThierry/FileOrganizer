<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileOrganizer.Desktop.ViewModels"
        xmlns:v="using:FileOrganizer.Desktop.Views"
        x:Class="FileOrganizer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="File Organizer"
        Icon="/Assets/appicon.ico"
        Width="1320" Height="860" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource Table}">
  <Window.Styles>
    <Style Selector="Border.sidebar"><Setter Property="Width" Value="232"/></Style>
    <!-- Narrow window: the sidebar shows only the icons (names as tooltips), which gives the pages 160 px more -->
    <ContainerQuery Name="app" Query="max-width:1280">
      <Style Selector="Border.sidebar"><Setter Property="Width" Value="72"/></Style>
      <Style Selector="StackPanel.brandtext"><Setter Property="IsVisible" Value="False"/></Style>
      <Style Selector="StackPanel.brand"><Setter Property="Margin" Value="19,22,0,0"/></Style>
      <Style Selector="TabControl.nav /template/ ItemsPresenter#PART_ItemsPresenter"><Setter Property="Width" Value="72"/></Style>
      <Style Selector="TabControl.nav TabItem"><Setter Property="Width" Value="48"/><Setter Property="Padding" Value="15,0"/></Style>
      <Style Selector="TextBlock.navlabel"><Setter Property="IsVisible" Value="False"/></Style>
    </ContainerQuery>
  </Window.Styles>
  <Panel Container.Name="app" Container.Sizing="Width">
    <!-- Sidebar: drawn behind the tab strip, which TabControl.nav lays out in the same column width (see App.axaml) -->
    <Border Classes="sidebar" HorizontalAlignment="Left" Background="{DynamicResource Sidebar}"
            BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel Classes="brand" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="20,22,16,0" VerticalAlignment="Top">
          <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentWash}">
            <Image Source="/Assets/appicon-32.png" Width="22" Height="22"/>
          </Border>
          <StackPanel Classes="brandtext" VerticalAlignment="Center">
            <TextBlock Text="File" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="Organizer" Classes="muted small"/>
          </StackPanel>
        </StackPanel>
        <Panel/>
      </DockPanel>
    </Border>

    <TabControl Classes="nav" TabStripPlacement="Left" Background="{x:Null}" Padding="16,8,16,0"
                SelectedIndex="{Binding SelectedTab}">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="Scan" ToolTip.Placement="Right">
            <PathIcon Classes="nav" Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            <TextBlock Classes="navlabel" Text="Scan" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <v:ScanView DataContext="{Binding Scan}"/>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="Review" ToolTip.Placement="Right">
            <PathIcon Classes="nav" Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
            <TextBlock Classes="navlabel" Text="Review" VerticalAlignment="Center"/>
            <Border IsVisible="{Binding HasReviewBadge}" Background="{DynamicResource Accent}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding ReviewBadge}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </TabItem.Header>
        <v:ReviewView DataContext="{Binding Review}"/>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="Unmatched" ToolTip.Placement="Right">
            <PathIcon Classes="nav" Data="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z"/>
            <TextBlock Classes="navlabel" Text="Unmatched" VerticalAlignment="Center"/>
            <Border IsVisible="{Binding HasUnmatchedBadge}" Background="{DynamicResource Warn}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding UnmatchedBadge}" Foreground="{DynamicResource Table}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </TabItem.Header>
        <v:UnmatchedView DataContext="{Binding Unmatched}"/>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="Rules" ToolTip.Placement="Right">
            <PathIcon Classes="nav" Data="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z"/>
            <TextBlock Classes="navlabel" Text="Rules" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <v:RulesView DataContext="{Binding Rules}"/>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="Settings" ToolTip.Placement="Right">
            <PathIcon Classes="nav" Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
            <TextBlock Classes="navlabel" Text="Settings" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <v:SettingsView DataContext="{Binding Settings}"/>
      </TabItem>
    </TabControl>
  </Panel>
</Window>
